{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "softm-hannun-account",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "0 2 * * *"
    ]
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://softm-hannun-account.softm.workers.dev",
    "ALLOW_NEW_REGISTRATIONS": "true",
    "NAVER_PUBLIC_ENABLED": "false",
    "ENABLE_ACCOUNT_DELETION": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "softm-hannun-account",
      "database_id": "ed975e05-b941-4f0e-9737-9b1526301b60"
    }
  ]
}
